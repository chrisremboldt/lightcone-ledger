# Development operators are enabled only in Vite dev mode on loopback.
VITE_LEDGER_ENV=local
# The Vite server proxies /v1 to localhost:4000 when this is empty.
VITE_API_URL=
# A deployment: set the hosted API URL and do not set local. Sign-in is configured on the API (LEDGER_OIDC_*), and
# the web app reads it from the API at startup.
