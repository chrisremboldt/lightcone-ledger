# Every variable Ledger reads. Copy this file to .env: the values set below work as they are with infra/compose.yaml
# and the seed, so a newcomer changes nothing. They are fixtures for the local stack, not secrets: never use them
# anywhere else. The line above each variable says what it is for and whether a production deployment needs it;
# docs/guides/deploy.md describes the production ones.

# --- Ledger itself: the API, the workers, migrations and the setup commands ---
# local or test allow development tokens and must never face a network; staging is every deployment. Production: required.
LEDGER_ENV=local
# production in a deployment, where any LEDGER_ENV other than staging is refused. Production: the image sets it.
# NODE_ENV=
# The address the API listens on. Production: the image sets it. (0.0.0.0)
HOST=127.0.0.1
# The port the API listens on; pnpm dev's web app forwards /v1 to it. Production: the image sets it. (4000)
PORT=4000
# The database owner's connection, for migrations and the setup commands only; never give it to the API or the workers. Production: required.
DATABASE_ADMIN_URL=postgresql://ledger_owner:ledger-local-owner@127.0.0.1:54329/ledger
# The API's connection, as the role ledger_app. Production: required.
DATABASE_URL=postgresql://ledger_app:ledger-local-app@127.0.0.1:54329/ledger
# The workers' connection, as the role ledger_worker. Production: required.
WORKER_DATABASE_URL=postgresql://ledger_worker:ledger-local-worker@127.0.0.1:54329/ledger
# The password the first migration creates ledger_app with. Production: required.
DATABASE_APP_PASSWORD=ledger-local-app
# An older name for DATABASE_APP_PASSWORD, read when that is unset. Production: not used.
# LEDGER_APP_PASSWORD=
# The password the first migration creates ledger_worker with. Production: required.
DATABASE_WORKER_PASSWORD=ledger-local-worker
# Database connections per process; default 10. Production: optional.
# DATABASE_POOL_SIZE=
# Comma-separated origins of the web app that may call the API; sign-in tokens are accepted only from these. Production: required.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Takes precedence over CORS_ORIGINS when set. Production: optional.
# WEB_ORIGINS=
# The built web app the API serves from its own origin. Production: the image sets it. (/app/apps/web/dist)
# LEDGER_WEB_DIR=
# The folder of the organization's own rule pack files (*.pack.json); give the API and the workers the same path and restart both after a change. Production: optional.
# LEDGER_PACKS_DIR=
# The invented example and demonstration packs (every shipped pack but Part 107 and the proposed Part 108). Unset: they are offered only to the seeded fictional organizations of a local stack, not to an organization made with pnpm org:create, and with LEDGER_ENV=staging not at all. 1 offers them to every organization, your own included; 0 leaves them out everywhere. Give the API and the workers the same value and restart both after a change. Production: optional.
# LEDGER_EXAMPLE_PACKS=
# The investigation assistant seam: leave it at 0. Production: not used.
LEDGER_INVESTIGATOR_ENABLED=0
# Where the investigation assistant seam reaches the API. Production: not used.
# LEDGER_INVESTIGATOR_API_ORIGIN=

# --- Notices by email and by webhook (docs/guides/deploy.md, Notices); email is off unless LEDGER_SMTP_HOST is set ---
# The address people open Ledger at; every link in a notice starts with it. Required with email. Production: optional.
LEDGER_PUBLIC_URL=http://127.0.0.1:5173
# The mail server notices are sent through; unset, no email is sent. Here, the emulators' stand-in. Production: optional.
LEDGER_SMTP_HOST=127.0.0.1
# The mail server's port; default 587, or 465 with LEDGER_SMTP_SECURE=1. Production: optional.
LEDGER_SMTP_PORT=4025
# 1 for a server that speaks TLS from the first byte (port 465); otherwise TLS is used when the server offers it. Production: optional.
# LEDGER_SMTP_SECURE=
# The account notices are sent with, when the mail server asks for one. Production: optional.
# LEDGER_SMTP_USER=
# That account's password. A secret: environment only. Production: optional.
# LEDGER_SMTP_PASSWORD=
# The address notices are sent from. Required with email. Production: optional.
LEDGER_SMTP_FROM=ledger-notices@example.org

# --- Object storage for the original bytes of every upload and import (the S3 emulator from infra/compose.yaml) ---
# s3 or disk. Unset: S3 with LEDGER_ENV=staging, a local folder otherwise. disk keeps files in OBJECT_STORAGE_DIR. Production: optional.
OBJECT_STORE=s3
# An older name for OBJECT_STORE. Production: not used.
# OBJECT_STORAGE_BACKEND=
# The folder for files with OBJECT_STORE=disk, an absolute path that must exist and be writable; in the image /data/ledger/files. Production: optional, required with disk.
# OBJECT_STORAGE_DIR=
# The storage provider's endpoint; leave unset for Amazon S3. Production: optional.
S3_ENDPOINT=http://127.0.0.1:9090
# The bucket. Production: required.
S3_BUCKET=ledger-local
# The region, where the provider needs one; default auto. Production: optional.
S3_REGION=us-east-1
# The key for that bucket only. Production: required.
S3_ACCESS_KEY_ID=local-access
# The key's secret. Production: required.
S3_SECRET_ACCESS_KEY=local-secret

# --- Sign-in through OpenID Connect (docs/guides/deploy.md, section 6) ---
# Sign-in through OpenID Connect (see docs/guides/deploy.md, section 6). Required with LEDGER_ENV=staging; read by
# the API and by pnpm org:create. Local development needs none of it: development tokens work without it. To try the
# real sign-in locally, run pnpm test-issuer and uncomment the first two lines. Production: required (these two, or
# LEDGER_OIDC_ISSUERS).
# LEDGER_OIDC_ISSUER=http://127.0.0.1:4010
# LEDGER_OIDC_CLIENT_ID=ledger-local
# What the sign-in and People screens call the provider. Defaults to the issuer's host name. Production: optional.
# LEDGER_OIDC_LABEL=
# true only for a provider that puts the web app's origin in the azp claim. Production: optional.
# LEDGER_OIDC_CHECK_AUTHORIZED_PARTY=
# Several issuers instead of the variables above, as a JSON list. Production: optional.
# LEDGER_OIDC_ISSUERS=[{"issuer":"https://id.example.org/realms/ledger","clientId":"ledger-web","label":"Example ID"}]
# The name the sign-in screen shows. Defaults to Ledger. Production: optional.
# LEDGER_DEPLOYMENT_NAME=
# The port pnpm test-issuer listens on, a local stand-in for a provider; default 4010. Production: not used.
# TEST_ISSUER_PORT=

# --- The services infra/compose.production.yaml starts beside Ledger, each only with its profile (deploy.md) ---
# The superuser password of the database profile's PostgreSQL, the owner in DATABASE_ADMIN_URL. Production: optional.
# LEDGER_DATABASE_OWNER_PASSWORD=
# The keycloak profile's public address, for example https://id.example.org. Production: optional.
# KEYCLOAK_URL=
# The password of Keycloak's own database in the keycloak profile. Production: optional.
# KEYCLOAK_DB_PASSWORD=
# The password of Keycloak's first administrator, bootstrap-admin; replace that account after the first sign-in. Production: optional.
# KEYCLOAK_BOOTSTRAP_PASSWORD=

# --- infra/compose.try.yaml, the start for trying Ledger on one computer (set in the shell that runs docker compose) ---
# The image it runs; default the published one, ghcr.io/<owner>/lightcone-ledger:latest. Production: not used.
# LEDGER_IMAGE=
# The port of this computer it publishes Ledger on, at 127.0.0.1 only. Production: not used. (4000)
# LEDGER_TRY_PORT=

# --- infra/compose.lite.yaml, Ledger Lite: one process, plain PostgreSQL, files on a volume (set in the shell) ---
# The port of this computer it publishes Ledger on, at 127.0.0.1 only, behind your TLS proxy. Production: optional. (4000)
# LEDGER_LITE_PORT=

# --- The web app, read when it is built ---
# The port pnpm dev serves the web app on; a port already taken stops it. Add its origin to CORS_ORIGINS. Production: not used. (5173)
# LEDGER_WEB_PORT=
# local for development, demo for the hosted demonstration build; leave unset for a deployment. Production: not used.
VITE_LEDGER_ENV=local
# The API's public URL; empty means the same origin, as the image serves it. Production: optional.
# VITE_API_URL=
# 1 shows the local walkthrough card in a development build. Production: not used.
# VITE_LEDGER_WALKTHROUGH=

# --- The image's supervisor: development tools start only when asked ---
# 1 starts the emulators inside the image. Production: not used.
# LEDGER_EMULATORS=
# off, trickle or world: runs the simulator inside the image. Production: not used.
# SIMULATOR_RUNTIME_MODE=
# 1 runs the isolated hosted-staging broker inside the image; refused anywhere else. Production: not used.
# DJI_MQTT_ENABLED=
# isolated: the simulator may run only against an isolated stack. Production: not used.
LEDGER_SIMULATION_TARGET=isolated
# The isolated hosted staging app that alone may run the hosted world. Production: not used.
# FLY_APP_NAME=

# --- The emulators of outside systems (development tools) ---
# Where the simulator reaches the emulators. Production: not used.
EMULATOR_BASE_URL=http://127.0.0.1:4002
# The address the emulators listen on. Production: not used.
EMULATOR_HOST=127.0.0.1
# The port the emulators listen on. Production: not used.
EMULATOR_PORT=4002
# The port of the emulators' mail server stand-in, which keeps every notice it is sent; default 4025. Production: not used.
EMULATOR_SMTP_PORT=4025
# The emulators' administration key. Production: not used.
EMULATOR_ADMIN_KEY=ledger-local-emulator-admin
# The origins the emulators may call back. Production: not used.
EMULATOR_CALLBACK_ORIGINS=http://127.0.0.1:4000,http://localhost:4000,http://127.0.0.1:4003
# The order emulator's key. Production: not used.
PARTNER_API_KEY=ledger-local-partner
# The Airspace Link emulator's machine client id. Production: not used.
AIRSPACE_CLIENT_ID=ledger-local-airhub
# The Airspace Link emulator's machine client secret. Production: not used.
AIRSPACE_CLIENT_SECRET=ledger-local-airhub-secret
# The Airspace Link emulator's API key. Production: not used.
AIRSPACE_API_KEY=ledger-local-airhub-api
# The Airspace Link emulator's simulated user sign-in client. Production: not used.
AIRSPACE_USER_CLIENT_ID=ledger-local-user
# The Airspace Link emulator's allowed sign-in redirects. Production: not used.
AIRSPACE_REDIRECT_URIS=http://127.0.0.1:4002/oauth/callback
# The Airspace Link emulator's callback signing secret. Production: not used.
AIRSPACE_CALLBACK_SECRET=ledger-local-airhub-callback
# The broker the standalone DJI device emulator publishes to. Production: not used.
# DJI_EMULATOR_MQTT_URL=
# The standalone DJI device emulator's broker account. Production: not used.
# DJI_EMULATOR_MQTT_USERNAME=
# That account's password. Production: not used.
# DJI_EMULATOR_MQTT_PASSWORD=
# The serial number the standalone DJI device emulator publishes as. Production: not used.
# DJI_EMULATOR_DEVICE_ID=
# The gateway serial number it names. Production: not used.
# DJI_EMULATOR_GATEWAY_ID=

# --- The simulator and its runs (development tools) ---
# Where the simulator, pnpm ledger, and an adapter process for a source, reach the API. Production: optional (an
# adapter process needs it; under the image's supervisor it defaults to the API in the same container).
LEDGER_API_URL=http://127.0.0.1:4000
# The credential pnpm ledger sends, from the environment of the shell that runs it; pnpm ledger does not read this
# file. Keep it in the git-ignored .ledger/credentials instead (docs/guides/set-up-with-a-coding-agent.md). Production: not used.
# LEDGER_TOKEN=
# An older name for LEDGER_API_URL. Production: not used.
# API_URL=
# Where the simulator listens for emulator callbacks. Production: not used.
SIMULATOR_CALLBACK_HOST=127.0.0.1
# The port it listens on. Production: not used.
SIMULATOR_CALLBACK_PORT=4003
# 1 trickles simulated flights during pnpm dev. Production: not used.
SIMULATOR_AUTORUN=0
# Milliseconds between trickled flights. Production: not used.
# SIMULATOR_INTERVAL_MS=
# The trickle's state file. Production: not used.
# SIMULATOR_TRICKLE_STATE=
# 1 flies trickled flights with telemetry over the broker. Production: not used.
# SIMULATOR_TELEMETRY=
# The continuing telemetry's working folder. Production: not used.
# SIMULATOR_TELEMETRY_DIR=
# Telemetry faults to inject: duplicate, late, reconnect. Production: not used.
# SIMULATOR_TELEMETRY_FAULTS=
# The most telemetry flights at once. Production: not used.
# SIMULATOR_TELEMETRY_MAX_FLIGHTS=
# The simulated day's random seed. Production: not used.
# SIMULATOR_SEED=
# When the simulated day starts. Production: not used.
# SIMULATOR_START=
# A fixed run id, for a reproducible recording; usable once per database. Production: not used.
# SIMULATOR_RUN_ID=
# Where pnpm scenario writes its report. Production: not used.
# SIMULATOR_REPORT_DIR=
# The broker of the isolated hosted-staging DJI scenario. Production: not used.
# DJI_MQTT_URL=
# Where the DJI scenario writes its report. Production: not used.
# DJI_REPORT_DIR=
# Where the DJI scenario keeps its adapter checkpoints. Production: not used.
# DJI_CHECKPOINT_DIR=
# Where the hosted-staging DJI scenario reaches the API. Production: not used.
# DJI_SCENARIO_API_URL=
# The DJI scenario's random seed. Production: not used.
# DJI_SCENARIO_SEED=
# When the DJI scenario's flight starts. Production: not used.
# DJI_SCENARIO_START=
# The in-image broker check's own fixture. Production: not used.
# MQTT_VERIFY_FIXTURE=

# --- The simulated operation (pnpm scenario:world and the hosted world; development tools) ---
# What the run does: preview, run and the others operation.ts names. Production: not used.
# SIMULATOR_WORLD_MODE=
# The world's state file. Production: not used.
# SIMULATOR_WORLD_STATE=
# The world's run id. Production: not used.
# SIMULATOR_WORLD_RUN_ID=
# When the world's day starts. Production: not used.
# SIMULATOR_WORLD_START=
# The world's random seed. Production: not used.
# SIMULATOR_WORLD_SEED=
# A named world profile. Production: not used.
# SIMULATOR_WORLD_PROFILE=
# A named capacity preset. Production: not used.
# SIMULATOR_WORLD_CAPACITY=
# An incident to play: none or landing-disagreement. Production: not used.
# SIMULATOR_WORLD_INCIDENT=
# Milliseconds between requested flights. Production: not used.
# SIMULATOR_WORLD_DEMAND_MS=
# Milliseconds between telemetry samples. Production: not used.
# SIMULATOR_WORLD_SAMPLE_MS=
# The world's length. Production: not used.
# SIMULATOR_WORLD_DURATION_MS=
# The start of the requested flight window. Production: not used.
# SIMULATOR_WORLD_REQUESTED_START=
# The end of the requested flight window. Production: not used.
# SIMULATOR_WORLD_REQUESTED_END=
# The world's broker bindings file. Production: not used.
# SIMULATOR_WORLD_BINDINGS=
# The world's broker profile. Production: not used.
# SIMULATOR_WORLD_BROKER_PROFILE=
# The world's own broker. Production: not used.
# SIMULATOR_WORLD_MQTT_URL=
# That broker's port. Production: not used.
# SIMULATOR_WORLD_MQTT_PORT=
# The world's callback port. Production: not used.
# SIMULATOR_WORLD_CALLBACK_PORT=
# Ordinary work to include: upcoming-bounded-incidents.1. Production: not used.
# SIMULATOR_WORLD_ORDINARY_WORK=
# Dispatch review to include: accepted-controls.1. Production: not used.
# SIMULATOR_WORLD_DISPATCH_REVIEW=
# A command-link episode to play. Production: not used.
# SIMULATOR_WORLD_COMMAND_LINK_EPISODE=
# The pre-departure flow to play. Production: not used.
# SIMULATOR_WORLD_PREDEPARTURE=
# The pre-departure attempt id. Production: not used.
# SIMULATOR_WORLD_PREDEPARTURE_ATTEMPT=
# The fictional organization the pre-departure flow runs for. Production: not used.
# SIMULATOR_WORLD_PREDEPARTURE_TENANT=
# The world's mission plan file. Production: not used.
# SIMULATOR_WORLD_MISSION_PLAN=
# The world's revision plan file. Production: not used.
# SIMULATOR_WORLD_REVISION_PLAN=
# The world's monitoring plan file. Production: not used.
# SIMULATOR_WORLD_MONITORING_PLAN=
# The monitoring source's token for the world. Production: not used.
# SIMULATOR_WORLD_MONITORING_TOKEN=
# The world's departure plan file. Production: not used.
# SIMULATOR_WORLD_DEPARTURE_PLAN=
# The world's departure state file. Production: not used.
# SIMULATOR_WORLD_DEPARTURE_STATE=
# The departing person's token for the world. Production: not used.
# SIMULATOR_WORLD_DEPARTURE_TOKEN=
# 1 plays the avoidance demonstration in the world. Production: not used.
# SIMULATOR_WORLD_AVOIDANCE_DEMO=
# The fictional person who acts in it. Production: not used.
# SIMULATOR_WORLD_AVOIDANCE_DEMO_ACTOR=
# A prepared safety rehearsal phase. Production: not used.
# SIMULATOR_WORLD_SMS_PREPARATION=

# --- The simulator's scripted actors, each with its plan, state file and token (development tools) ---
# pnpm scenario:pack:adopt: its plan file. Production: not used.
# SIMULATOR_ADOPTION_PLAN=
# pnpm scenario:pack:adopt: its state file. Production: not used.
# SIMULATOR_ADOPTION_STATE=
# pnpm scenario:pack:adopt: its token. Production: not used.
# SIMULATOR_ADOPTION_TOKEN=
# pnpm scenario:adoption:review: its plan file. Production: not used.
# SIMULATOR_REVIEW_PLAN=
# pnpm scenario:adoption:review: its state file. Production: not used.
# SIMULATOR_REVIEW_STATE=
# pnpm scenario:adoption:review: its token. Production: not used.
# SIMULATOR_REVIEW_TOKEN=
# pnpm scenario:hazard: its plan file. Production: not used.
# SIMULATOR_HAZARD_PLAN=
# pnpm scenario:hazard: its state file. Production: not used.
# SIMULATOR_HAZARD_STATE=
# pnpm scenario:hazard: its token. Production: not used.
# SIMULATOR_HAZARD_TOKEN=
# pnpm scenario:hazard:control: its plan file. Production: not used.
# SIMULATOR_CONTROL_PLAN=
# pnpm scenario:hazard:control: its state file. Production: not used.
# SIMULATOR_CONTROL_STATE=
# pnpm scenario:hazard:control: its token. Production: not used.
# SIMULATOR_CONTROL_TOKEN=
# pnpm scenario:mission:release: its plan file. Production: not used.
# SIMULATOR_RELEASE_PLAN=
# pnpm scenario:mission:release: its state file. Production: not used.
# SIMULATOR_RELEASE_STATE=
# pnpm scenario:mission:release: its token. Production: not used.
# SIMULATOR_RELEASE_TOKEN=
# pnpm scenario:control:calculate: its plan file. Production: not used.
# SIMULATOR_EFFECTIVENESS_PLAN=
# pnpm scenario:control:calculate: its state file. Production: not used.
# SIMULATOR_EFFECTIVENESS_STATE=
# pnpm scenario:control:calculate: its token. Production: not used.
# SIMULATOR_EFFECTIVENESS_TOKEN=
# pnpm scenario:control:review: its plan file. Production: not used.
# SIMULATOR_EFFECTIVENESS_REVIEW_PLAN=
# pnpm scenario:control:review: its state file. Production: not used.
# SIMULATOR_EFFECTIVENESS_REVIEW_STATE=
# pnpm scenario:control:review: its token. Production: not used.
# SIMULATOR_EFFECTIVENESS_REVIEW_TOKEN=
# The flight whose rule selection the adoption actor reads. Production: not used.
# SIMULATOR_ADOPTION_SELECTION_FLIGHT_ID=
# What pnpm scenario:world:oracle checks. Production: not used.
# SIMULATOR_ORACLE_KIND=
# The attempt it checks. Production: not used.
# SIMULATOR_ORACLE_ATTEMPT=
# The fictional organization it checks. Production: not used.
# SIMULATOR_ORACLE_TENANT=
# Its token. Production: not used.
# SIMULATOR_ORACLE_TOKEN=
# pnpm scenario:sms:prepare: its configuration file. Production: not used.
# SIMULATOR_SMS_CONFIG=
# The safety rehearsal phase to prepare. Production: not used.
# SIMULATOR_SMS_PHASE=
# When the rehearsal's day starts. Production: not used.
# SIMULATOR_SMS_START=
# The rehearsal's control selection file. Production: not used.
# SIMULATOR_SMS_CONTROL_SELECTION=
# The rehearsal's departure selection file. Production: not used.
# SIMULATOR_SMS_DEPARTURE_SELECTION=
# The rehearsal's calculation selection file. Production: not used.
# SIMULATOR_SMS_CALCULATION_SELECTION=
# The rehearsal's review selection file. Production: not used.
# SIMULATOR_SMS_REVIEW_SELECTION=

# --- An adapter process for one source (pnpm adapter:run; docs/guides/deploy.md, section 10) ---
# The adapter to run, for the image's supervisor or its adapter command; unset, none runs. Production: optional.
# LEDGER_ADAPTER=
# The source's API credential, as issued. A secret: environment only. Production: optional (an adapter process).
# LEDGER_API_CREDENTIAL=
# The label that credential was issued with, named when Ledger refuses it. Production: optional (an adapter process).
# LEDGER_CREDENTIAL_LABEL=
# The source id the observations are submitted under; default the one its grants name. Production: optional.
# LEDGER_SOURCE_ID=
# The broker, mqtts://host:8883 (mqtt:// on this host). Production: optional (an adapter that reads the broker).
# ADAPTER_BROKER_URL=
# The source's broker account, its id. Production: optional (an adapter that reads the broker).
# ADAPTER_BROKER_USERNAME=
# That account's password. A secret: environment only. Production: optional (an adapter that reads the broker).
# ADAPTER_BROKER_PASSWORD=
# The aircraft's serial number. Production: optional (an aircraft adapter).
# ADAPTER_DEVICE=
# The dock or controller the aircraft reports through. Production: optional (an aircraft adapter).
# ADAPTER_GATEWAY=
# The dock's serial number. Production: optional (the dock adapter).
# ADAPTER_DOCK=
# The site the dock stands at. Production: optional (the dock adapter).
# ADAPTER_SITE=
# The dock model: dock2, dock3 or dock4. Production: optional (the dock adapter).
# ADAPTER_DOCK_MODEL=
# The service's address. Production: optional (the airspace authorization and weather report adapters).
# ADAPTER_SERVICE_URL=
# The service's access token, sent as a bearer token. A secret: environment only. Production: optional (the same).
# ADAPTER_SERVICE_TOKEN=
# The service's API key, if it asks for one. A secret: environment only. Production: optional (the same).
# ADAPTER_SERVICE_API_KEY=
# The service's operation id. Production: optional (the airspace authorization adapter).
# ADAPTER_OPERATION=
# The Ledger flight the operation was requested for. Production: optional (the airspace authorization adapter).
# ADAPTER_FLIGHT=
# Weather stations and the sites each reports for: STATION=SITE[@DISTANCE in m or km], separated by semicolons.
# Production: optional (the weather report adapter).
# ADAPTER_STATIONS=
# Seconds between reads of the service, at least 5; default 60, 300 for weather reports. Production: optional.
# ADAPTER_POLL_SECONDS=
# Messages held while Ledger cannot be reached; default 10000. Production: optional.
# ADAPTER_QUEUE_LIMIT=
# How long a stop waits to submit what is held; default 10. Production: optional.
# ADAPTER_SHUTDOWN_SECONDS=
# 1 allows http:// and mqtt:// to another host on a private network you control. Production: optional.
# ADAPTER_PRIVATE_NETWORK=

# --- The checks ---
# The database pnpm test:integration uses; default ledger_test. Production: not used.
# LEDGER_TEST_DATABASE=
# The web app the browser tests and demo recordings open, and the address pnpm org:create tells a new administrator to
# open; default http://127.0.0.1:5173. Production: not used.
# WEB_URL=
# The browser channel Playwright uses. Production: not used.
# PLAYWRIGHT_CHANNEL=

# ======================================================================================================================
# --- The seeded fictional organizations: only for pnpm db:seed (development tools) ---
# Everything that names one of the fictional organizations pnpm db:seed creates is in this block, and nothing outside it
# does. Keep it to run the seeded organizations, the simulator and the browser tests; delete it for a Ledger that holds
# only an organization of your own (pnpm org:create): the API and the workers start without it.
# ======================================================================================================================
# The fictional pre-departure flow for the seeded organizations; ordinary dispatch still needs explicit activation. Production: not used.
LEDGER_FLIGHT_PREDEPARTURE={"version":"flight.predeparture-config.1","tenants":[{"tenantId":"tenant-alpha","source":{"principalId":"principal-alpha-source","missionSourceId":"mission-planner","automaticReleasePrincipalId":"principal-alpha-source"}},{"tenantId":"tenant-beta","source":{"principalId":"principal-beta-source","missionSourceId":"mission-planner","automaticReleasePrincipalId":"principal-beta-source"}}]}
# The repeatable avoidance demonstration for the fictional Alpha tenant; uncomment to enable it locally (tests/browser/avoidance-demo.spec.ts). Production: not used.
# LEDGER_SIMULATION_AVOIDANCE_DEMO={"version":"simulation.avoidance-demo-config.1","tenants":[{"tenantId":"tenant-alpha","source":{"principalId":"principal-alpha-source","missionSourceId":"mission-planner","commandLinkSourceId":"command-link","monitoringSourceId":"operation-monitoring"}}]}
# The fictional Alpha source's development token. Production: not used.
ALPHA_SOURCE_TOKEN=ledger-dev-alpha-source
# The fictional Alpha field crew's development token. Production: not used.
ALPHA_ACTOR_TOKEN=ledger-dev-alpha-actor
# The fictional Alpha dispatcher's development token. Production: not used.
ALPHA_OPERATOR_TOKEN=ledger-dev-alpha-operator
# The fictional Beta source's development token. Production: not used.
BETA_SOURCE_TOKEN=ledger-dev-beta-source
# The fictional Beta field crew's development token. Production: not used.
BETA_ACTOR_TOKEN=ledger-dev-beta-actor
# The isolated hosted-staging broker's alpha device account name. Production: not used.
# DJI_ALPHA_DEVICE_USERNAME=
# The isolated hosted-staging broker's alpha device account password. Production: not used.
# DJI_ALPHA_DEVICE_PASSWORD=
# The isolated hosted-staging broker's alpha adapter account name. Production: not used.
# DJI_ALPHA_ADAPTER_USERNAME=
# The isolated hosted-staging broker's alpha adapter account password. Production: not used.
# DJI_ALPHA_ADAPTER_PASSWORD=
# The isolated hosted-staging broker's beta device account name. Production: not used.
# DJI_BETA_DEVICE_USERNAME=
