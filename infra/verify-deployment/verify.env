# The verification's settings. Fixtures for this local run only, never for a deployment: every password here is public.
LEDGER_ENV=staging
DATABASE_URL=postgresql://ledger_app:verify-app@postgres:5432/ledger
WORKER_DATABASE_URL=postgresql://ledger_worker:verify-worker@postgres:5432/ledger
DATABASE_APP_PASSWORD=verify-app
DATABASE_WORKER_PASSWORD=verify-worker
S3_ENDPOINT=http://objects:8333
S3_BUCKET=ledger
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=verify-access
S3_SECRET_ACCESS_KEY=verify-secret-verify-secret
CORS_ORIGINS=https://ledger.localhost:18443
LEDGER_OIDC_ISSUER=https://id.localhost:18443/realms/ledger
LEDGER_OIDC_CLIENT_ID=ledger-web
LEDGER_OIDC_LABEL=Example ID
LEDGER_DEPLOYMENT_NAME=Example Ridge Survey
KEYCLOAK_URL=https://id.localhost:18443
KEYCLOAK_DB_PASSWORD=verify-keycloak-db
KEYCLOAK_BOOTSTRAP_PASSWORD=verify-keycloak-admin
