{
  "name": "lightcone-ledger",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.0",
  "homepage": "https://lightconesystems.com/ledger/open-source/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisremboldt/lightcone-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/chrisremboldt/lightcone-ledger/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "playwright test",
    "test:simulator-transport": "vitest run --config vitest.transport.config.ts",
    "verify": "pnpm format:check && pnpm build && pnpm check:production-build && pnpm typecheck && pnpm test",
    "check:production-build": "node tools/check-production-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "vendor:airspace": "node apps/emulators/scripts/fetch-airspace-link.mjs",
    "db:migrate": "tsx packages/persistence/src/migrate.ts",
    "db:backfill:references": "tsx apps/api/src/backfill-observation-references.ts",
    "org:create": "tsx apps/api/src/create-organization.ts",
    "credential:issue": "tsx apps/api/src/issue-credential.ts",
    "development-token:issue": "tsx apps/api/src/issue-development-token.ts",
    "ledger": "node --import tsx packages/cli/src/main.ts",
    "broker:files": "tsx apps/api/src/write-broker-files.ts",
    "broker:files:dev": "tsx apps/api/src/write-broker-files.ts --out infra/mqtt/accounts --listen tenant-alpha=1883 --listen tenant-beta=1884 --development-passwords",
    "test-issuer": "tsx tests/oidc/start-test-issuer.ts",
    "db:seed": "tsx packages/persistence/src/seed.ts && tsx apps/api/src/seed-risk-matrices.ts && tsx apps/api/src/seed-flight-procedures.ts && tsx apps/api/src/seed-utility.ts",
    "demo:documents": "tsx apps/api/src/seed-utility-documents.ts",
    "adapter:run": "node --import tsx apps/adapter-host/src/main.ts",
    "scenario": "tsx apps/simulator/src/scenario.ts",
    "scenario:telemetry": "tsx apps/simulator/src/dji-scenario.ts",
    "scenario:world": "node --env-file-if-exists=.env --import tsx apps/simulator/src/operation.ts",
    "scenario:world:oracle": "node --import tsx apps/simulator/src/attempt-oracle-cli.ts",
    "scenario:pack:adopt": "node --import tsx apps/simulator/src/pack-adoption-cli.ts",
    "scenario:adoption:review": "node --import tsx apps/simulator/src/adoption-review-cli.ts",
    "scenario:hazard": "node --import tsx apps/simulator/src/hazard-cli.ts",
    "scenario:hazard:control": "node --import tsx apps/simulator/src/hazard-control-cli.ts",
    "scenario:mission:release": "node --import tsx apps/simulator/src/mission-release-cli.ts",
    "scenario:control:calculate": "node --import tsx apps/simulator/src/control-effectiveness-cli.ts",
    "scenario:control:review": "node --import tsx apps/simulator/src/control-effectiveness-review-cli.ts",
    "scenario:sms:prepare": "node --import tsx apps/simulator/src/sms-rehearsal-cli.ts",
    "generate:client": "tsx packages/contracts/src/generate.ts",
    "pack:new": "node --import tsx packages/standard-packs/src/pack-cli.ts new",
    "pack:build": "node --import tsx packages/standard-packs/src/pack-cli.ts build",
    "pack:check": "node --import tsx packages/standard-packs/src/pack-cli.ts check",
    "pack:list": "node --import tsx packages/standard-packs/src/pack-cli.ts list",
    "pack:kinds": "node --import tsx packages/standard-packs/src/pack-cli.ts kinds",
    "verify:bundle": "node tools/verifier/cli.mjs",
    "demo": "tools/demo.sh",
    "demo:record": "node tools/record-demo-tape.mjs",
    "demo:build": "pnpm --filter @ledger/web build:demo",
    "walkthrough": "tools/walkthrough.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "18.0.5",
    "jose": "6.2.18",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
